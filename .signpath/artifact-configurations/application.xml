<?xml version="1.0" encoding="utf-8"?>
<!-- The app itself, before it goes into the installer. The name and version must match the file's own metadata. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="exam-desktop.exe" product-name="Exam Trainer" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
