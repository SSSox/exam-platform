{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exam Trainer",
  "version": "0.1.0",
  "identifier": "kz.examtrainer.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Exam Trainer", "width": 1200, "height": 800, "minWidth": 380, "minHeight": 560 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/SSSox/exam-platform/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
